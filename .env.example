# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://dexpert.in

# Calendly scheduling links (one per booking type). Leave blank to fall back to the default link.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/dexpert/strategy-call
NEXT_PUBLIC_CALENDLY_AI_DEMO_URL=
NEXT_PUBLIC_CALENDLY_AUTOMATION_URL=
NEXT_PUBLIC_CALENDLY_MARKETING_URL=

# CRM webhook: every lead (forms, tools, audits) is POSTed here as JSON.
# Works with GoHighLevel, HubSpot workflows, Zapier, Make, n8n, Pabbly, etc.
CRM_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header.
CRM_WEBHOOK_SECRET=

# Optional: Google PageSpeed Insights API key. When set, the Website Grader adds real Lighthouse scores.
PAGESPEED_API_KEY=

# Optional analytics
NEXT_PUBLIC_GA_ID=
